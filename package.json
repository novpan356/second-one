{
  "name": "tekken-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:lore-ui": "node tests/lore-ui.mjs",
    "test:community-ui": "node tests/community-ui.mjs",
    "test:visitor-ui": "node tests/visitor-ui.mjs",
    "test:auth-ui": "node tests/auth-ui.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:icons": "node scripts/android-icons.mjs",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:mobile-ui": "node tests/mobile-ui.mjs",
    "test:dojo-ui": "node tests/dojo-ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/network": "8.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.56.0",
    "sharp": "0.35.5",
    "vite": "^7.3.0"
  }
